# Copy to .env and adjust before `docker compose up`
# SQL Server SA password (must meet complexity rules)
MSSQL_SA_PASSWORD=Your_Strong_Password123

# JWT signing key (min 32 characters)
JWT_KEY=JameJafari-Change-This-Key-In-Production-Min32!!

# Bale bot token (from @botfather in Bale — never commit real value)
BALE_BOT_TOKEN=

# Optional: default group chat id or @channel — seeds first MessageChannel row only
# BALE_DEFAULT_GROUP_CHAT_ID=-1001234567890
# BALE_DEFAULT_GROUP_CHAT_ID=@yourchannel

# Optional: bot username for deep links (without @)
# BALE_BOT_USERNAME=your_bot

# Optional: webhook secret header X-Bale-Webhook-Secret
# BALE_WEBHOOK_SECRET=

# Rubika bot token (from @BotFather in Rubika — never commit real value)
RUBIKA_BOT_TOKEN=

# Optional: Rubika bot username for profile link (without @)
# RUBIKA_BOT_USERNAME=your_bot

# Optional: webhook secret header X-Rubika-Webhook-Secret
# RUBIKA_WEBHOOK_SECRET=

# Public HTTPS origin of this API (no trailing slash) — required to register webhooks
# MESSAGING_PUBLIC_BASE_URL=https://app.example.com
